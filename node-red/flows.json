    {
        "id": "ea227d5e46595780",
        "type": "function",
        "z": "fb7c89d7f2eeb81a",
        "name": "function 1",
        "func": "const message = String(msg.payload).trim();\nlet logs = context.get(\"logs\") || [];\nlet eventText = \"\";\n\nif (message === \"MOTION_DETECTED\") {\n    eventText = \"Có chuyển động\";\n} else if (message === \"CLEAR\") {\n    eventText = \"Không còn chuyển động.\";\n} else {\n    return null;\n}\n\nif (logs.length > 0 && logs[0][\"Sự kiện\"] === eventText) {\n    return null;\n}\n\nconst now = new Date();\nlogs.unshift({\n    \"Ngày\": now.toLocaleDateString(\"vi-VN\"),\n    \"Giờ\": now.toLocaleTimeString(\"vi-VN\"),\n    \"Sự kiện\": eventText\n});\n\nif (logs.length > 20) {\n    logs = logs.slice(0, 20);\n}\n\ncontext.set(\"logs\", logs);\nmsg.payload = logs;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
